    "top-offers-steam": {
        "kind": "listing",
        "url": "https://store.steampowered.com/sale/special_deals",
        "waitUntil": "networkidle2",
        "waitForSelector": "a[href*=\"/app/\"]",
        "scrollBeforeExtract": true,
        "container": "a[href*=\"/app/\"]:has(img[alt]:not([alt=\"\"]))",
        "limit": 8,
        "expectedMin": 3,
        "currency": "USD",
        "fields": {
            "name": {
                "selector": "img",
                "attr": "alt"
            },
            "imgUrl": {
                "selector": "img",
                "attr": "src"
            },
            "price": {
                "textPattern": "^\\$\\d",
                "patternIndex": -1,
                "optional": true
            },
            "priceOld": {
                "textPattern": "^\\$\\d",
                "patternIndex": 0,
                "patternMinCount": 2,
                "optional": true
            },
            "discount": {
                "textPattern": "^-\\d+%$",
                "optional": true
            },
            "url": {
                "selector": null,
                "attr": "href"
            }
        },
        "fallbackPriceText": "No encontrado"
    }
}
