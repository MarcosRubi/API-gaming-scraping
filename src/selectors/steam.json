    "overwhelmingly-positive": {
        "kind": "listing",
        "url": "https://store.steampowered.com/search/?sort_by=_ASC&category1=998&os=win",
        "waitUntil": "networkidle2",
        "waitForSelector": "#search_resultsRows",
        "scrollBeforeExtract": true,
        "container": "#search_resultsRows a.search_result_row",
        "limit": 12,
        "expectedMin": 5,
        "fields": {
            "name": {
                "selector": ".title",
                "attr": "text"
            },
            "imgUrl": {
                "selector": ".search_capsule img",
