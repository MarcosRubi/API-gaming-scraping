{
    "search": {
        "kind": "search",
        "url": "https://store.steampowered.com/search/?term={term}",
        "waitForSelector": "#search_resultsRows",
        "container": "#search_resultsRows a.search_result_row",
        "limit": 5,
        "expectedMin": 1,
        "notFoundShape": "steam",
        "fields": {
            "name": {
                "selector": ".title",
                "attr": "text"
            },
            "imgUrl": {
                "selector": ".search_capsule img",
                "attr": "src"
            },
            "price": {
                "selector": ".discount_final_price",
                "attr": "text",
                "optional": true
            },
            "priceOld": {
                "selector": ".discount_original_price",
                "attr": "text",
                "optional": true
            },
            "discount": {
                "selector": ".discount_pct",
                "attr": "text",
                "optional": true
            },
            "url": {
                "selector": null,
                "attr": "href"
            }
        },
        "fallbackPriceText": "No encontrado",
        "currency": "USD"
    },
