# Plantilla de variables de entorno. Copiala como:
#   .env.development  → npm run start:dev
#   .env.qa           → npm run start:qa (y docker compose en el VPS)
# Esos archivos NO se suben al repo.

# development | qa | production (los scripts lo definen solos)
APP_ENV=development
PORT=3000

# Orígenes del frontend permitidos (CORS + guard), separados por comas. Obligatoria.
ALLOWED_ORIGINS=http://localhost:4200
# true = rechazar requests sin cabecera Origin/Referer (curl, navegador directo)
REQUIRE_ORIGIN=false

# Frecuencia de refresco de los listados (cron)
CACHE_REFRESH_CRON=0 * * * *

# Región e idioma para precios y textos de Steam
STEAM_COUNTRY=US
STEAM_LANGUAGE=spanish

# Auto-reparación de selectores con OpenAI (opcional: vacío = desactivada)
OPENAI_API_KEY=
SELF_HEAL_MODEL=gpt-4o-mini
SELF_HEAL_COOLDOWN_MS=3600000
