PORT=3000
CACHE_REFRESH_CRON=0 * * * *

# Auto-reparación de selectores (opcional): sin esta key el sistema sigue
# funcionando igual, simplemente sin auto-heal cuando un sitio cambie su HTML.
OPENAI_API_KEY=
SELF_HEAL_MODEL=gpt-4o-mini
SELF_HEAL_COOLDOWN_MS=3600000

# Orígenes permitidos (separados por comas). Sin definir: el frontend publicado
# en producción, o localhost:5173/3000 en desarrollo.
# ALLOWED_ORIGIN=https://games-scraping.mrubi.dev
